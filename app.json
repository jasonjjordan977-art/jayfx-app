{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.ags5control_g7x2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0C0D0F"
      }
    },
    "extra": {
      "apiUrl": "https://ags5con-3r1rgiv-preview-4200.runable.site/",
      "applicationId": "ags5con-3r1rgiv",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.ags5control-g7x2.runable",
      "supportsTablet": true
    },
    "name": "AGS5 Control",
    "slug": "ags5-control",
    "version": "1.0.0",
    "scheme": "runable-ags5con-3r1rgiv",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#0C0D0F"
        }
      ]
    ]
  }
}
